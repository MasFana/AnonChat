# HTTP listener
ADDR=127.0.0.1:8000
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
PPROF_TOKEN=

# In-memory admission and retention limits
MAX_ROOMS=1000
MAX_USERS_PER_ROOM=1000
MAX_MESSAGES_PER_ROOM=1000
MAX_EVENT_RING=256
MAX_SUBSCRIBERS_PER_ROOM=100
MAX_SUBSCRIPTIONS_PER_USER=4
MAX_SSE_QUEUE_FRAMES=32
MAX_ROOM_COMMAND_QUEUE=256
MAX_MESSAGE_BYTES=65536
MAX_REQUEST_BODY_BYTES=131072
MAX_POLL_OPTIONS=8
MAX_RATE_LIMIT_KEYS=10000
# Multiplier for all per-minute rate limits. Default 10 supports high traffic.
RATE_LIMIT_MULTIPLIER=10

# Lifecycle and SSE timing
OWNER_AWAY_GRACE_MS=5000
HEARTBEAT_INTERVAL_MS=15000